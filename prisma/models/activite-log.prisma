model ActiviteLog {
  id         Int       @id @default(autoincrement()) @map("id_log")
  userId     Int?      @map("id_utilisateur")
  action     String    @map("action") @db.VarChar(100)
  resource   String    @map("ressource") @db.VarChar(100)
  resourceId Int?      @map("id_ressource")
  detail     String?   @map("detail")
  ip         String?   @map("ip") @db.VarChar(45)
  date       DateTime  @default(now()) @map("date")

  utilisateur Utilisateur? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([date], map: "idx_log_date")
  @@index([action], map: "idx_log_action")
  @@map("journal_activite")
}