model Alerte {
  id                Int          @id @default(autoincrement()) @map("id_alerte")
  maladieId         Int?         @map("id_maladie")
  zoneId            Int          @map("id_zone")
  niveauRisque      NiveauRisque @default(Normal) @map("niveau_risque")
  statut            StatutAlerte @default(Active) @map("statut_alerte")
  detectionDate     DateTime     @default(now()) @map("date_detection")
  detectedCaseCount Int          @default(0) @map("nombre_cas_detectes")
  commentaire       String?      @map("commentaire")
  ruleId            Int?         @map("id_regle")
  createdById       Int?         @map("id_createur")
  assigneeId        Int?         @map("id_charge")
  resolvedById      Int?         @map("id_resolution")
  resolvedAt        DateTime?    @map("date_resolution")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  maladie   Maladie?           @relation(fields: [maladieId], references: [id], onDelete: SetNull)
  zone      ZoneAdministrative @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  regle     RegleAlerte?       @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  createur  Utilisateur?       @relation("AlerteCreateur", fields: [createdById], references: [id], onDelete: SetNull)
  assignee  Utilisateur?       @relation("AlerteAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  resolveur Utilisateur?       @relation("AlerteResolveur", fields: [resolvedById], references: [id], onDelete: SetNull)

  historique AlerteHistorique[]

  @@index([statut], map: "idx_alerte_statut")
  @@index([niveauRisque], map: "idx_alerte_niveau")
  @@map("alertes")
}
