model Utilisateur {
  id                Int      @id @default(autoincrement()) @map("id_utilisateur")
  name              String   @map("nom") @db.VarChar(150)
  email             String   @unique @map("email") @db.VarChar(150)
  phoneNumber       String?  @map("phone_number") @db.VarChar(30)
  passwordHash      String   @map("mot_de_passe_hash") @db.VarChar(255)
  temporaryPassword Boolean  @default(true) @map("mot_de_passe_temporaire")
  resetToken        String?  @unique @map("token_reinitialisation") @db.VarChar(255)
  isActive          Boolean  @default(true) @map("is_active")
  roleId            Int      @map("id_role")
  centreId          Int?     @map("id_centre")
  regionId          Int?     @map("id_region")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Réinitialisation de mot de passe (flux "mot de passe oublié")
  passwordResetCode           String?   @map("code_reinitialisation") @db.VarChar(255)
  passwordResetCodeExpiresAt  DateTime? @map("code_reinitialisation_expire")
  passwordResetAttempts       Int       @default(0) @map("tentatives_reinitialisation")
  passwordResetToken          String?   @map("jeton_reinitialisation") @db.VarChar(255)
  passwordResetTokenExpiresAt DateTime? @map("jeton_reinitialisation_expire")

  role   Role                @relation(fields: [roleId], references: [id], onDelete: Restrict)
  centre CentreSante?        @relation(fields: [centreId], references: [id], onDelete: SetNull)
  region ZoneAdministrative? @relation("UtilisateurRegion", fields: [regionId], references: [id], onDelete: SetNull)

  casDeclares CasEpidemiologique[] @relation("CasAgent")
  casAnalyses CasEpidemiologique[] @relation("CasLaboratoire")

  signalementsCrees   Signalement[] @relation("SignalementCreateur")
  signalementsDecides Signalement[] @relation("SignalementDecideur")

  alertesCrees       Alerte[]           @relation("AlerteCreateur")
  alertesAssignees   Alerte[]           @relation("AlerteAssignee")
  alertesResolues    Alerte[]           @relation("AlerteResolveur")
  alertesHistoriques AlerteHistorique[]

  logsActivite ActiviteLog[]
  sessions     SessionToken[]

  @@map("utilisateurs")
}
