model LoginAttempt {
  id      Int      @id @default(autoincrement()) @map("id_tentative")
  email   String   @map("email") @db.VarChar(150)
  ip      String?  @map("ip") @db.VarChar(45)
  success Boolean  @default(false) @map("succes")
  date    DateTime @default(now()) @map("date")

  @@index([email], map: "idx_tentative_email")
  @@index([date], map: "idx_tentative_date")
  @@map("tentatives_connexion")
}