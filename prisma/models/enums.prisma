enum TypeZone {
  Region
  District
  Commune
  Fokontany

  @@map("type_zone_enum")
}

enum TypeCentre {
  CSB1
  CSB2
  CHRD
  CHRR
  CHU

  @@map("type_centre_enum")
}

enum StatutDiag {
  Suspect
  Confirme
  Invalide

  @@map("statut_diag_enum")
}

enum IssueClinique {
  EnCours    @map("En_cours")
  Gueri
  Deces
  PerduDeVue @map("Perdu_de_vue")

  @@map("issue_clinique_enum")
}

enum StatutAlerte {
  Active
  EnPriseEnCharge @map("En_prise_en_charge")
  Resolue

  @@map("statut_alerte_enum")
}

enum NiveauRisque {
  Normal
  Surveillance
  Alerte
  Critique

  @@map("niveau_risque_enum")
}

enum ActionHistorique {
  Creation
  Detection
  PriseEnCharge
  Resolution
  Reouverture
  MiseAJour

  @@map("action_historique_enum")
}

enum StatutSignalement {
  Brouillon
  EnAttente
  Valide
  Rejete

  @@map("statut_signalement_enum")
}
