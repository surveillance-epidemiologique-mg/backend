DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/epidemiologique_mg?schema=public"

ADMIN_NAME="Administrateur"
ADMIN_EMAIL="admin@surveillance.mg"
ADMIN_PASSWORD="VotreMotDePasse"

# Serveur
PORT=3001
FRONTEND_URL="http://localhost:3000"

# Authentification JWT
JWT_SECRET="CHANGEZ_MOI_AVEC_UNE_CHAINE_ALEATOIRE"
JWT_EXPIRES_IN=86400
# Durée de session « Se souvenir de moi » (30 jours par défaut)
JWT_REMEMBER_ME_EXPIRES_IN=2592000
JWT_COOKIE_NAME="access_token"
BCRYPT_ROUNDS=12

# E-mail
# EMAIL_MODE: "simulation" (aucun envoi réel, contenu affiché en console — par défaut en dev)
#             "smtp" (envoi réel via le serveur SMTP configuré ci-dessous)
EMAIL_MODE="simulation"

# SMTP (Nodemailer) — uniquement utilisé si EMAIL_MODE="smtp"
# Ne mettez JAMAIS de mot de passe réel ici : ces valeurs sont des exemples.
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="noreply@example.com"
SMTP_PASS="MOT_DE_PASSE_APPLICATION"
MAIL_FROM="noreply@example.com"
MAIL_FROM_NAME="Surveillance Epidemiologique Madagascar"