DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/epidemiologique_mg?schema=public"

ADMIN_NAME="Administrateur"
ADMIN_EMAIL="admin@surveillance.mg"
ADMIN_PASSWORD="VotreMotDePasse"

# Serveur
PORT=3001
# En production : URL publique du frontend (https://...) — les liens
# d'activation envoyés par e-mail utilisent cette URL.
FRONTEND_URL="http://localhost:3000"

# Authentification JWT
JWT_SECRET="CHANGEZ_MOI_AVEC_UNE_CHAINE_ALEATOIRE"
JWT_EXPIRES_IN=86400
# Durée de session « Se souvenir de moi » (30 jours par défaut)
JWT_REMEMBER_ME_EXPIRES_IN=2592000
JWT_COOKIE_NAME="access_token"
BCRYPT_ROUNDS=12

# E-mail — API Brevo (transactionnel)
# Obligatoire : CLÉ API Brevo (v3), préfixe "xkeysib-".
# ⚠️ Ce n'est PAS la clé SMTP (préfixe "xsmtpsib-") — l'API transactionnelle refuse les clés SMTP.
# Brevo → Paramètres → SMTP & API → API Keys → créer/copier une clé (xkeysib-…).
# Ne JAMAIS committer la valeur réelle de la clé ; fournir uniquement via l'environnement.
BREVO_API_KEY="xkeysib-VOTRE_CLE_API_BREVO"

# Adresse d'expéditeur.
# Le domaine et/ou l'adresse doivent être vérifiés dans le compte Brevo
# (onglet « Expéditeurs & IP ») pour l'envoi en production.
# Ex : "ÉpiSuivi <notifications@votredomaine.mg>"
MAIL_FROM="notifications@votredomaine.mg"